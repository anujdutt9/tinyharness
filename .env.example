# Only for developing tinyharness itself: in a git checkout, keys are also read from a
# .env file here (copy this file to .env). Normal installs keep keys in
# ~/.tinyharness/auth.json (`/key <provider>`) or your shell. Shell variables win.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# Optional: force a model for this shell, e.g. in CI (provider:model or a bare id)
# TINYHARNESS_MODEL=openai:gpt-6-sol
