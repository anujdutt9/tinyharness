# API keys for a single project: copy this file to .env in that project.
# For keys you use everywhere, use ~/.config/tinyharness/.env instead (running
# `tinyharness` with no key creates it). Variables already set in your shell win.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# Optional: force a model for this shell, e.g. in CI (provider:model or a bare id)
# TINYHARNESS_MODEL=openai:gpt-6-sol
