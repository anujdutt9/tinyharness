# API keys. Easiest: just run `tinyharness` and it will ask for one and save it to
# ~/.config/tinyharness/.env. Or copy this file to .env in your project.
# Variables already set in your shell win.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# Optional: force a model for this shell, e.g. in CI (provider:model or a bare id)
# TINYHARNESS_MODEL=openai:gpt-6-sol
